{
  "manifest_version": 3,
  "name": "Page Assistant",
  "version": "1.0.0",
  "description": "A browser extension for reading page content and interacting with AI models",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "downloads.shelf"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
